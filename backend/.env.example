# ==============================================================================
# GGPS School ERP - Backend Environment Configuration Example
# ==============================================================================

# Server Runtime Configuration
PORT=5001
NODE_ENV=development

# Database Connection (MongoDB)
MONGO_URI=mongodb://localhost:27017/global_international_erp

# Cryptographic Authentication Secrets
# In non-development environments, JWT_SECRET or JWT_ACCESS_SECRET MUST be explicitly set.
JWT_SECRET=your_jwt_access_secret_key_change_in_production_min_32_chars
JWT_ACCESS_SECRET=your_jwt_access_secret_key_change_in_production_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_in_production_min_32_chars

# CORS and Allowed Origins
# CLIENT_URL is the primary web application domain
CLIENT_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# CORS_ORIGINS: Comma-separated list of explicit allowed origins (e.g., https://erp.ggps.edu.in,https://preview.ggps.edu.in)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Payment Gateway Configuration (Razorpay / Stripe)
# Secret key used for cryptographic HMAC-SHA256 signature verification of order payments
PAYMENT_GATEWAY_KEY_ID=rzp_test_your_key_id_here
PAYMENT_GATEWAY_SECRET=your_payment_gateway_secret_here

# Notification & Email Services (Optional / Production)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@ggps.edu.in
SMTP_PASS=your_smtp_app_password
EMAIL_FROM="GGPS School ERP" <notifications@ggps.edu.in>
